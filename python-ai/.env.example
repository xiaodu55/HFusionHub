# Chat model configuration. Configure DeepSeek or a locally running Ollama.
# Never enable LLM_ALLOW_MOCK outside of isolated development tests.
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
OLLAMA_BASE_URL=http://localhost:11434
# Deprecated for embeddings (use OLLAMA_EMBEDDING_MODEL); now only sets the
# default model name of the Ollama chat fallback provider.
# OLLAMA_MODEL=qwen2.5:3b
LLM_ALLOW_MOCK=false

# Optional OpenAI-compatible backup provider (B2). Any chat-completions
# compatible endpoint (OpenAI, 通义, Kimi, ...). When set, it joins the
# failover chain after DeepSeek/Ollama.
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_MODEL=

# Local embedding model configuration
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_ALLOW_FALLBACK=false

# Milvus Configuration
MILVUS_COLLECTION=hfusionhub_chunks
MILVUS_LITE_PATH=./milvus_data.db

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=9000
SERVER_DEBUG=false
# Comma-separated frontend origins. Use * only when credentials are disabled.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# File Storage
UPLOAD_DIR=./uploads

# Java Backend URL (for callback)
JAVA_BACKEND_URL=http://localhost:8080

# Internal auth token 鈥?must match Java's PYTHON_AI_INTERNAL_TOKEN
PYTHON_AI_INTERNAL_TOKEN=replace-with-a-long-random-token
CALLBACK_SECRET=replace-with-a-long-random-callback-secret

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Embedding Configuration
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_DELAY=1.0
# 查询向量缓存（R16-5）：仅缓存检索侧 query embedding（LRU+TTL）；TTL=0 禁用
EMBEDDING_QUERY_CACHE_TTL_SECONDS=600
EMBEDDING_QUERY_CACHE_MAX_ENTRIES=256
# 文档索引批量嵌入（R16-7）：单批大小与批间并发（GPU 部署可调大批次）
EMBEDDING_DOC_BATCH_SIZE=32
EMBEDDING_DOC_BATCH_CONCURRENCY=2

# Hybrid retrieval (vector + BM25 keyword retrieval with Reciprocal Rank Fusion)
RAG_HYBRID_ENABLED=true
RAG_RRF_K=60
RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=3
RAG_RETRIEVAL_MAX_CANDIDATES=30
RAG_MIN_EVIDENCE_SCORE=0.35

# P7 GraphRAG.  It is disabled by default.  When enabled, the graph channel
# returns only graph facts whose source chunks remain in the selected KB.
RAG_GRAPH_ENABLED=false
RAG_GRAPH_INDEX_PATH=./data/rag_scoped_graph.json

# Durable RAG evaluation history (aggregate metrics and failed case IDs only)
RAG_EVALUATION_DB_PATH=./data/rag_evaluation_runs.db

# P6 second-stage reranking — now enabled by default in lexical mode
# (zero-dependency, deterministic, always safe). The Java feature flag
# `rag.reranker.enabled` also defaults to ON (Flyway V58) and can be toggled
# from the frontend "能力开关" page. cross_encoder additionally needs:
# pip install -r requirements-reranker.txt (falls back to no-op if missing).
RAG_RERANKER_MODE=lexical
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RERANK_CANDIDATE_COUNT=20

# P8 multimodal evidence enrichment.  It stays off by default.  Evidence is
# fed back into the normal scoped text retrieval pipeline, not a separate
# global image index.  Two engines, tried in order:
#   1. vision-LLM (recommended): Ollama vision model describes images —
#      pull the model first, e.g. `ollama pull qwen2.5vl:3b`.
#   2. Tesseract OCR fallback (needs the tesseract binary on PATH).
RAG_MULTIMODAL_ENABLED=false
RAG_MULTIMODAL_OCR_ENABLED=false
RAG_MULTIMODAL_OCR_COMMAND=tesseract
RAG_MULTIMODAL_OCR_LANGUAGE=eng
RAG_MULTIMODAL_MAX_IMAGES_PER_DOCUMENT=20
RAG_MULTIMODAL_MAX_IMAGE_BYTES=10485760
RAG_MULTIMODAL_MAX_OCR_CHARACTERS=3000
RAG_MULTIMODAL_OCR_TIMEOUT_SECONDS=20
RAG_MULTIMODAL_VLM_ENABLED=false
RAG_MULTIMODAL_VLM_MODEL=qwen2.5vl:3b
# Defaults to OLLAMA_BASE_URL when empty.
RAG_MULTIMODAL_VLM_BASE_URL=
RAG_MULTIMODAL_VLM_TIMEOUT_SECONDS=90

# P9 bounded single-agent workflow.  Disabled until its focused regression
# suite is green.  Only these Agent V1 read-only tools may be invoked by the
# model: search_knowledge_base, read_chunk, list_document_chunks.
# Non-V1 tools (calculate, get_current_time, web_search) are available only
# when explicitly added here, but the V1 WorkflowRuntime hard-enforces the
# V1 whitelist regardless of this setting.
RAG_AGENT_WORKFLOW_ENABLED=false
RAG_AGENT_TIMEOUT_SECONDS=45
RAG_AGENT_MAX_RETRIES=1
RAG_AGENT_RETRY_DELAY_SECONDS=0.2
RAG_AGENT_MAX_STEPS=12
RAG_AGENT_TOOL_TIMEOUT_SECONDS=10
RAG_AGENT_MAX_SEARCH_RESULTS=5
RAG_AGENT_ALLOWED_TOOLS=search_knowledge_base,read_chunk,list_document_chunks

# P10: evidence-reviewed multi-agent collaboration. Unlocked (Flyway V59):
# the `agent.multi_agent.enabled` runtime flag now defaults to TRUE. Requires
# P9 (agent.enabled) and an explicitly selected knowledge base; output is
# buffered until citations pass the local scope critic.
RAG_MULTI_AGENT_ENABLED=false
RAG_MULTI_AGENT_TIMEOUT_SECONDS=60
# Batch 9：多 Agent 编排模式（pipeline | supervisor | handoff，默认 pipeline）
RAG_MULTI_AGENT_MODE=pipeline

# ── 长期记忆接线（2026-08-30 Batch 1）────────────────────────────
# 生效开关由 Java feature flag memory.long_term.enabled 统一治理（V80，默认 FALSE），
# 以下 env 仅作为 flag 后端不可达时的降级回退值。开启后：
#   - 每 MEMORY_CONSOLIDATE_EVERY_TURNS 轮对话后台做一次 LLM 记忆抽取（消耗 token）
#   - 会话删除前 Java 回调 /api/internal/memory/consolidate 做最终抽取
#   - Agent 回答前经 /internal/memory/relevant 注入相关长期记忆
MEMORY_LONG_TERM_ENABLED=false
MEMORY_CONSOLIDATE_EVERY_TURNS=6
MEMORY_CONTEXT_MAX_ENTRIES=8
MEMORY_CONTEXT_MAX_TOKENS=600
MEMORY_INTERNAL_TIMEOUT_SECONDS=5

# ── 原生 function calling（2026-08-30 Batch 2）───────────────────
# 生效开关由 Java flag agent.native_tool_calls.enabled 统一治理（V81，默认 FALSE）。
# 开启后 ReAct 优先用 provider 原生 tool-calls（DeepSeek / OpenAI 兼容 / Ollama ≥0.4），
# provider 不支持或调用失败时自动降级为文本 Thought/Action 协议。
AGENT_NATIVE_TOOL_CALLS_ENABLED=false

# ── 语音 STT/TTS（Batch 10，默认关闭）────────────────────────────
# 引擎为 OpenAI 兼容音频接口；开启后聊天页出现语音输入与播报按钮。
# 需配置可用的 STT/TTS 端点与模型（通义/OpenAI 或网关兼容层）。
VOICE_ENABLED=false
VOICE_OPENAI_BASE_URL=
VOICE_OPENAI_API_KEY=
VOICE_STT_MODEL=
VOICE_TTS_MODEL=
VOICE_TTS_VOICE=alloy
VOICE_TIMEOUT_SECONDS=60

# 鈹€鈹€ Feature Flags (runtime overrides via Java backend) 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
# When JAVA_BACKEND_URL is set, the Python service syncs feature flags from
# the Java backend every 30 seconds.  Flags below are evaluated via the
# /api/feature-flag/all endpoint and override the static env-var values.
# Set JAVA_BACKEND_URL to enable runtime flag evaluation.

# Vector store: cluster = 独立 Milvus Standalone（docker compose 的 milvus 服务），lite = 嵌入式本地文件
VECTOR_STORE_MODE=cluster
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 启用 Milvus 认证时填写（compose 设 MILVUS_AUTH_ENABLED=true 后，用 root 与下列密码）
# MILVUS_USER=root
# MILVUS_PASSWORD=replace-with-milvus-root-password

