# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Milvus Configuration
MILVUS_COLLECTION=hfusionhub_chunks
MILVUS_LITE_PATH=./milvus_data.db

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=9000
SERVER_DEBUG=false
# Comma-separated frontend origins. Use * only when credentials are disabled.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Storage
UPLOAD_DIR=./uploads

# Java Backend URL (for callback)
JAVA_BACKEND_URL=http://localhost:8080

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Embedding Configuration
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_DELAY=1.0

# Hybrid retrieval (vector + BM25 keyword retrieval with Reciprocal Rank Fusion)
RAG_HYBRID_ENABLED=true
RAG_RRF_K=60
RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=3
RAG_RETRIEVAL_MAX_CANDIDATES=30
RAG_MIN_EVIDENCE_SCORE=0.35

# P7 GraphRAG.  It is disabled by default.  When enabled, the graph channel
# returns only graph facts whose source chunks remain in the selected KB.
RAG_GRAPH_ENABLED=false
RAG_GRAPH_INDEX_PATH=./data/rag_scoped_graph.json

# Durable RAG evaluation history (aggregate metrics and failed case IDs only)
RAG_EVALUATION_DB_PATH=./data/rag_evaluation_runs.db

# Optional P6 second-stage reranking. Keep disabled until an offline benchmark
# shows an improvement. Use lexical for a deterministic control; cross_encoder
# additionally needs: pip install -r requirements-reranker.txt
RAG_RERANKER_MODE=disabled
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RERANK_CANDIDATE_COUNT=20

# P8 multimodal evidence enrichment.  It stays off by default.  OCR evidence
# is fed back into the normal scoped text retrieval pipeline, not a separate
# global image index.  Install requirements-multimodal.txt plus Tesseract first.
RAG_MULTIMODAL_ENABLED=false
RAG_MULTIMODAL_OCR_ENABLED=false
RAG_MULTIMODAL_OCR_COMMAND=tesseract
RAG_MULTIMODAL_OCR_LANGUAGE=eng
RAG_MULTIMODAL_MAX_IMAGES_PER_DOCUMENT=20
RAG_MULTIMODAL_MAX_IMAGE_BYTES=10485760
RAG_MULTIMODAL_MAX_OCR_CHARACTERS=3000
RAG_MULTIMODAL_OCR_TIMEOUT_SECONDS=20

# P9 bounded single-agent workflow.  Disabled until its focused regression
# suite is green.  Only these Agent V1 read-only tools may be invoked by the
# model: search_knowledge_base, read_chunk, list_document_chunks.
# Non-V1 tools (calculate, get_current_time, web_search) are available only
# when explicitly added here, but the V1 WorkflowRuntime hard-enforces the
# V1 whitelist regardless of this setting.
RAG_AGENT_WORKFLOW_ENABLED=false
RAG_AGENT_TIMEOUT_SECONDS=45
RAG_AGENT_MAX_RETRIES=1
RAG_AGENT_RETRY_DELAY_SECONDS=0.2
RAG_AGENT_MAX_STEPS=5
RAG_AGENT_TOOL_TIMEOUT_SECONDS=10
RAG_AGENT_MAX_SEARCH_RESULTS=5
RAG_AGENT_ALLOWED_TOOLS=search_knowledge_base,read_chunk,list_document_chunks

# P10: evidence-reviewed multi-agent collaboration. Requires P9 and an
# explicitly selected knowledge base; output is buffered until citations pass
# the local scope critic.
RAG_MULTI_AGENT_ENABLED=false
RAG_MULTI_AGENT_TIMEOUT_SECONDS=60

# ── Feature Flags (runtime overrides via Java backend) ──────────────────────
# When JAVA_BACKEND_URL is set, the Python service syncs feature flags from
# the Java backend every 30 seconds.  Flags below are evaluated via the
# /api/feature-flag/all endpoint and override the static env-var values.
# Set JAVA_BACKEND_URL to enable runtime flag evaluation.
