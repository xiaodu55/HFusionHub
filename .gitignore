python-ai/tests/.tmp-*/

# --- Test / Debug files ---
test_response.json
*_response.json
*.response.json

# --- Runner TLS 私钥（绝不提交；由 scripts/generate-runner-tls.sh 生成） ---
deploy/runner-tls/

# --- Data backups (scripts/backup-data.ps1 / scripts/backup-mysql.sh output) ---
backup/
backups/

# --- 平台内建插件签名私钥（绝不提交；scripts/plugin-provision.sh 首次运行时生成） ---
deploy/plugin-signing/

# --- 插件信任策略（仅含平台公钥，随部署环境生成） ---
python-ai/plugins/trust/

# --- ZCode 会话产物 ---
.zcode/

# HFusionData Analytics — 运行时生成的 Flink 提交脚本(内含注入的真实密码,严禁入库)
bigdata/flink-jobs/_run_*.sql
bigdata/flink-jobs/_exec_*.sql
bigdata/flink-jobs/_t[0-9]*.sql
bigdata/flink-jobs/_test_part.sql
