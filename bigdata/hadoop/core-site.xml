<?xml version="1.0" encoding="UTF-8"?>
<!--
  HFusionData Analytics — Hadoop 核心配置(单机精简档)
  挂载为 /opt/hadoop/etc/hadoop(apache/hadoop:3.3.6 官方镜像)。
  标准档(集群):fs.defaultFS 指向 HA 地址,dfs.replication 调 2-3。
-->
<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://hadoop-namenode:9000</value>
  </property>
  <property>
    <name>io.file.buffer.size</name>
    <value>131072</value>
  </property>
  <!-- 运行时以 root 用户提交作业(单机演示);集群档建议专用 hfusion 用户 -->
  <property>
    <name>hadoop.http.staticuser.user</name>
    <value>root</value>
  </property>
  <!-- HDFS 短路读关闭(容器跨主机名场景简单可靠) -->
  <property>
    <name>dfs.client.use.datanode.hostname</name>
    <value>true</value>
  </property>
</configuration>
