<?xml version="1.0" encoding="UTF-8"?>
<!-- HFusionData Analytics — MapReduce 配置(MapReduce 词频示例作业走 YARN) -->
<configuration>
  <property>
    <name>mapreduce.framework.name</name>
    <value>yarn</value>
  </property>
  <property>
    <name>mapreduce.map.memory.mb</name>
    <value>768</value>
  </property>
  <property>
    <name>mapreduce.reduce.memory.mb</name>
    <value>768</value>
  </property>
  <property>
    <name>yarn.app.mapreduce.am.resource.mb</name>
    <value>768</value>
  </property>
</configuration>
