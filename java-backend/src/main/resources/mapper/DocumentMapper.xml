<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hfusionhub.mapper.DocumentMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hfusionhub.entity.Document">
        <id column="id" property="id"/>
        <result column="knowledge_base_id" property="knowledgeBaseId"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="file_path" property="filePath"/>
        <result column="file_type" property="fileType"/>
        <result column="file_size" property="fileSize"/>
        <result column="chunk_count" property="chunkCount"/>
        <result column="status" property="status"/>
        <result column="error_message" property="errorMessage"/>
        <result column="processed_at" property="processedAt"/>
        <result column="recycled_at" property="recycledAt"/>
        <result column="recycle_expires_at" property="recycleExpiresAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, knowledge_base_id, title, content, file_path, file_type, file_size,
        chunk_count, status, error_message, processed_at,
        recycled_at, recycle_expires_at,
        created_at, updated_at, deleted
    </sql>

    <!-- 根据知识库ID统计文档数量 -->
    <select id="countByKnowledgeBaseId" resultType="int">
        SELECT COUNT(*)
        FROM document
        WHERE knowledge_base_id = #{knowledgeBaseId}
        AND deleted = 0
    </select>

</mapper>
