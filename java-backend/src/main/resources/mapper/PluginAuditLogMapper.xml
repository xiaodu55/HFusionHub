<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hfusionhub.mapper.PluginAuditLogMapper">

    <resultMap id="BaseResultMap" type="com.hfusionhub.entity.PluginAuditLog">
        <id column="id" property="id"/>
        <result column="event_id" property="eventId"/>
        <result column="plugin_id" property="pluginId"/>
        <result column="plugin_name" property="pluginName"/>
        <result column="action" property="action"/>
        <result column="operator_id" property="operatorId"/>
        <result column="old_value" property="oldValue"/>
        <result column="new_value" property="newValue"/>
        <result column="reason" property="reason"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, event_id, plugin_id, plugin_name, action, operator_id, old_value, new_value, reason, created_at
    </sql>

    <select id="selectByPluginId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM plugin_audit_log
        WHERE plugin_id = #{pluginId}
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <select id="selectByOperatorId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM plugin_audit_log
        WHERE operator_id = #{operatorId}
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <select id="selectByEventId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM plugin_audit_log
        WHERE event_id = #{eventId}
        LIMIT 1
    </select>

</mapper>
