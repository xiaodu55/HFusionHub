<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hfusionhub.mapper.MessageMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hfusionhub.entity.Message">
        <id column="id" property="id"/>
        <result column="conversation_id" property="conversationId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="token_count" property="tokenCount"/>
        <result column="model" property="model"/>
        <result column="sources" property="sources" typeHandler="com.hfusionhub.handler.JsonTypeHandler"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="request_id" property="requestId"/>
        <!-- 对话图片输入（V84）：相对 URL JSON 数组 -->
        <result column="images" property="images"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, conversation_id, role, content, token_count, model, sources, created_at, updated_at, request_id, images
    </sql>

    <!-- 按对话ID查询消息列表（使用 BaseResultMap 以正确反序列化 sources JSON） -->
    <select id="selectByConversationId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM message
        WHERE conversation_id = #{conversationId}
        ORDER BY created_at ASC
        <!-- 防无界返回：单对话历史上限 1000 条（对任何实际对话均足够），
             避免超长对话时整表消息一次性返回 -->
        LIMIT 1000
    </select>

    <!-- 批量聚合：一次查询获取每个对话的消息数量和最新消息 -->
    <select id="aggregateByConversationIds" resultType="java.util.HashMap">
        SELECT
            m1.conversation_id AS conversationId,
            COUNT(*) AS msgCount,
            (SELECT m2.content FROM message m2
             WHERE m2.conversation_id = m1.conversation_id
             ORDER BY m2.created_at DESC LIMIT 1) AS lastMessage
        FROM message m1
        WHERE m1.conversation_id IN
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
        GROUP BY m1.conversation_id
    </select>

</mapper>
