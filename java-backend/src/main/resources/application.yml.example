server:
  port: 8080
  servlet:
    context-path: /api

spring:
  application:
    name: hfusionhub-backend

  # 数据源配置
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/hfusionhub?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:}

  # Redis 配置
  data:
    redis:
      host: localhost
      port: 6379
      password: ${REDIS_PASSWORD:}
      database: 0
      timeout: 10000ms

  # Jackson 配置
  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Shanghai
    serialization:
      write-dates-as-timestamps: false

# MyBatis Plus 配置
mybatis-plus:
  mapper-locations: classpath:mapper/**/*.xml
  type-aliases-package: com.hfusionhub.entity
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

# Sa-Token 配置
sa-token:
  token-name: satoken
  timeout: 86400
  active-timeout: 1800
  is-concurrent: true
  token-style: uuid
  is-log: false

# Knife4j 配置
springdoc:
  swagger-ui:
    path: /swagger-ui.html
    tags-sorter: alpha
    operations-sorter: alpha
  api-docs:
    path: /v3/api-docs
  group-configs:
    - group: HFusionHub
      paths-to-match: /**
      packages-to-scan: com.hfusionhub.controller

knife4j:
  enable: true
  setting:
    language: zh_cn

# Python AI 服务配置
python-ai:
  base-url: http://localhost:8001
  timeout: 60000
  engine:
    url: http://localhost:8001

rag:
  index:
    stale-after-minutes: ${RAG_INDEX_STALE_AFTER_MINUTES:30}
    max-attempts: ${RAG_INDEX_MAX_ATTEMPTS:3}
    recovery-delay-ms: ${RAG_INDEX_RECOVERY_DELAY_MS:300000}

# MinIO 配置
minio:
  endpoint: http://localhost:9000
  access-key: ${MINIO_ACCESS_KEY:minioadmin}
  secret-key: ${MINIO_SECRET_KEY:minioadmin}
  bucket-name: hfusionhub

# 日志配置
logging:
  level:
    root: INFO
    com.hfusionhub: DEBUG
    com.hfusionhub.mapper: DEBUG
