# HFusionHub Production Environment Variables
# Copy to deploy/.env and replace all placeholder values.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_PASSWORD=replace-with-strong-db-password

# --- Redis ---
REDIS_PASSWORD=replace-with-strong-redis-password

# --- Auth & Security ---
PYTHON_AI_INTERNAL_TOKEN=replace-with-long-random-token-1
CALLBACK_SECRET=replace-with-long-random-token-2
ADMIN_PASSWORD=replace-with-strong-admin-password
# Used only between python-ai and the internal plugin-runner service.
PLUGIN_RUNNER_TOKEN=replace-with-long-random-token-3

# --- Isolated Plugin Runner ---
# A TLS-protected Docker Engine dedicated to plugin execution. Do not use or
# mount /var/run/docker.sock. These three client-certificate paths are mounted
# as Compose secrets at /certs/client/{ca.pem,cert.pem,key.pem}.
PLUGIN_RUNNER_DOCKER_HOST=tcp://plugin-docker.example.internal:2376
PLUGIN_RUNNER_CA_CERT_FILE=/secure/path/ca.pem
PLUGIN_RUNNER_CLIENT_CERT_FILE=/secure/path/cert.pem
PLUGIN_RUNNER_CLIENT_KEY_FILE=/secure/path/key.pem

# --- AI Service ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Feature Flags (optional) ---
# RAG_GRAPH_ENABLED=false
# RAG_RERANKER_MODE=disabled
