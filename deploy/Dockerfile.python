# HFusionHub Python AI Dockerfile
# 多阶段构建：安装依赖后切换到非 root 用户运行（最小权限）

FROM python:3.11-slim AS base
WORKDIR /app

# Install system deps for document parsing + healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# uvicorn[standard] installs uvloop + httptools for better streaming performance.
# `--require-hashes` 不需要谁显式开启：锁里任一条目带 `--hash=` 时 pip 就自动进入该模式，
# 并拒绝所有裸 pin（3cd5303 的 sed 绕法针对的正是它，它一直在生效）。因此往这份
# pip-compile 哈希锁上手工追加无哈希条目，会让整镜像构建在 collect 之后整体失败。
RUN pip install --no-cache-dir -r requirements.txt
# Batch 8：arq（任务队列 worker）。requirements.txt 为 pip-compile 哈希锁文件，
# arq 以显式钉版本在此单独安装（升级需同步修改此处与 requirements.in）。
RUN pip install --no-cache-dir "arq==0.26.3"
# OpenTelemetry 分布式追踪（app/utils/telemetry.py，未装则降级为 no-op）。同样不能进锁尾：
# 补哈希要求它的 closure（opentelemetry-proto/-semantic-conventions/-exporter-otlp-proto-common/
# googleapis-common-protos/deprecated）全部进锁，那是另一次重编译。版本不能停在 1.29.0——
# 其 opentelemetry-proto 要 protobuf<6.0，与锁里的 protobuf==7.35.1（# via pymilvus）冲突；
# 1.45.1 放宽到 <8.0，且 requires-python>=3.10 与本镜像 3.11 相符。
RUN pip install --no-cache-dir \
    "opentelemetry-api==1.45.1" \
    "opentelemetry-sdk==1.45.1" \
    "opentelemetry-exporter-otlp-proto-http==1.45.1"

COPY app/ app/
# arq worker 的入口模块在仓库根的顶层（不是 app/ 的子包）：compose 的
# `python -m arq arq_worker.WorkerSettings` 与 python-ai/arq_worker.py 的 docstring、
# app/core/tasks/queue.py、app/utils/config.py 的注释都用同一条命令，只有 /app 下真的
# 存在 arq_worker.py 才成立。缺这一行时 worker 在容器里 ModuleNotFoundError 崩溃循环，
# 而失败点是队列侧（job 滞留、解析永远不回调），API 层看起来一切正常。
# 门禁 = scripts/static-checks.py --container-runtime-contract（检查 18 规则①）。
COPY arq_worker.py .
# 运行身份必须钉死：`useradd -r` 从 Debian 系统池（100–999）按基镜像当时占了哪些号
# 分配 uid，重建镜像就可能换号，而卷的属主（helm 的 fsGroup、compose 命名卷首次
# 初始化时继承的镜像属主）都按这个数字对齐。10001 在两侧系统池之外，且与
# deploy/Dockerfile.java、helm values.yaml 的 podSecurity 同号——三处由
# scripts/static-checks.py --container-uid 核对。
# /app/uploads、/app/audit-queue 与 /app/eval-harness 是 helm 三个卷的挂载点：空卷的
# 属主来自镜像在该路径上的内容，路径不存在则由 provisioner/root 建，非 root 进程就写不进去。
RUN mkdir -p /data/uploads /data /app/uploads /app/audit-queue /app/eval-harness \
    && groupadd -r -g 10001 hfusionhub && useradd -r -u 10001 -g 10001 -d /app hfusionhub \
    && chown -R hfusionhub:hfusionhub /app /data

USER hfusionhub
EXPOSE 9000
HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
    CMD curl -f http://localhost:9000/health || exit 1

CMD ["python", "-m", "app.main"]
