# HFusionHub Python AI Dockerfile
# 多阶段构建：安装依赖后切换到非 root 用户运行（最小权限）

FROM python:3.11-slim AS base
WORKDIR /app

# Install system deps for document parsing + healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# uvicorn[standard] installs uvloop + httptools for better streaming performance.
# The sed workaround (3cd5303) was for --require-hashes mode, which is no longer
# used. Restoring [standard] for production-grade event loop.
RUN pip install --no-cache-dir -r requirements.txt
# Batch 8：arq（任务队列 worker）。requirements.txt 为 pip-compile 哈希锁文件，
# arq 以显式钉版本在此单独安装（升级需同步修改此处与 requirements.in）。
RUN pip install --no-cache-dir "arq==0.26.3"

COPY app/ app/
# 运行身份必须钉死：`useradd -r` 从 Debian 系统池（100–999）按基镜像当时占了哪些号
# 分配 uid，重建镜像就可能换号，而卷的属主（helm 的 fsGroup、compose 命名卷首次
# 初始化时继承的镜像属主）都按这个数字对齐。10001 在两侧系统池之外，且与
# deploy/Dockerfile.java、helm values.yaml 的 podSecurity 同号——三处由
# scripts/static-checks.py --container-uid 核对。
# /app/uploads、/app/audit-queue 与 /app/eval-harness 是 helm 三个卷的挂载点：空卷的
# 属主来自镜像在该路径上的内容，路径不存在则由 provisioner/root 建，非 root 进程就写不进去。
RUN mkdir -p /data/uploads /data /app/uploads /app/audit-queue /app/eval-harness \
    && groupadd -r -g 10001 hfusionhub && useradd -r -u 10001 -g 10001 -d /app hfusionhub \
    && chown -R hfusionhub:hfusionhub /app /data

USER hfusionhub
EXPOSE 9000
HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
    CMD curl -f http://localhost:9000/health || exit 1

CMD ["python", "-m", "app.main"]
