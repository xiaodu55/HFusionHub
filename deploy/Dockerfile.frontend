# HFusionHub Frontend — Nginx static serving
FROM node:22.12-alpine AS build
WORKDIR /app
COPY hfusionhub-frontend/package.json hfusionhub-frontend/package-lock.json ./
RUN npm ci
COPY hfusionhub-frontend/ .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
