# MySQL Configuration
MYSQL_ROOT_PASSWORD=root123456
MYSQL_PASSWORD=hfusionhub123

# Redis Configuration
REDIS_PASSWORD=your_redis_password

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
