# MySQL Configuration — 复制为 docker/.env 后运行 scripts/init-env.ps1（或 init-env.sh）
# 自动生成强随机口令，切勿直接使用本示例值
MYSQL_ROOT_PASSWORD=changeme-strong-root-password
MYSQL_PASSWORD=changeme-strong-db-password

# Redis Configuration
REDIS_PASSWORD=changeme-strong-redis-password

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-strong-minio-password

# Plugin Runner (required — docker compose up will fail without this)
PLUGIN_RUNNER_TOKEN=changeme-long-random-token

# Admin initialization (set to bootstrap the first admin account)
ADMIN_PASSWORD=changeme-strong-admin-password

# Java <-> Python 共享令牌（fullstack 模式 / 生产部署时使用，必须一致）
PYTHON_AI_INTERNAL_TOKEN=changeme-long-random-token
CALLBACK_SECRET=changeme-long-random-secret

# AI 供应商（可选，默认 DeepSeek；也可在页面「模型中心」配置）
DEEPSEEK_API_KEY=sk-replace-with-your-own-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 本地 Ollama 地址（容器内访问宿主机时用 http://host.docker.internal:11434）
OLLAMA_BASE_URL=http://localhost:11434
