FROM python:3.12-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

RUN useradd --no-create-home --shell /bin/false pluginuser

WORKDIR /opt/plugin-runner

COPY python-ai/requirements.txt /opt/requirements.txt
RUN pip install --no-cache-dir -r /opt/requirements.txt && \
    pip install --no-cache-dir docker>=7.0.0 httpx>=0.27.0

COPY docker/plugin-runner/ /opt/plugin-runner/

RUN chown -R pluginuser:pluginuser /opt/plugin-runner && \
    mkdir -p /opt/plugin-artifacts && \
    chown -R pluginuser:pluginuser /opt/plugin-artifacts

USER pluginuser

EXPOSE 9100

ENTRYPOINT ["python", "-m", "app"]
