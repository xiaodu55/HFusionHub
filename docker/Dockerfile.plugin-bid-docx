# hfusionhub-plugin-bid-docx — 标书 docx 导出插件镜像
# 容器契约：/opt/plugin/run_tool.py 固定入口 + PLUGIN_TOOL_NAME/INPUT 环境变量
# 构建上下文 = 仓库根目录
FROM python:3.12-slim

# 网络策略执行需要 iptables（runner 注入 iptables OUTPUT 规则）
RUN apt-get update && \
    apt-get install -y --no-install-recommends iptables netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir python-docx==1.1.0

WORKDIR /opt/plugin
COPY docker/plugin-runner/run_tool.py /opt/plugin/run_tool.py
COPY python-ai/plugins/bid_docx/tools.py /opt/plugin/tools.py
RUN chmod +x /opt/plugin/run_tool.py
