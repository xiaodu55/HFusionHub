# Normalize line endings: shell scripts must be LF (CRLF breaks POSIX sh).
*.sh text eol=lf
*.bash text eol=lf

# PowerShell scripts keep CRLF-friendly handling but remain UTF-8 (with BOM).
*.ps1 text eol=crlf

# Keep text files autocrlf-normalized.
*.py text eol=lf
*.java text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
